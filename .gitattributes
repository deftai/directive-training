# Deft framework: the vendored payload is packaged framework code, not
# consumer source. text=auto + eol=lf normalizes text only; binaries keep
# byte identity. Mark generated + vendored (#1430, #2118, #5245).
.deft/core/** linguist-generated=true linguist-vendored=true text=auto eol=lf

# Module-numbering migration: these protected records are hashed byte-for-byte.
# Pin LF so checkout settings cannot alter the protected-history evidence.
.deft/approved-scope/** text eol=lf
history/** text eol=lf
xbrief/completed/** text eol=lf
